#!/bin/sh
# weather-secrets.sh — copy this file to weather-secrets.sh and fill in your values.
# This file is committed to the repository. weather-secrets.sh is NOT.

# URL of the weather image (e.g. your S3 bucket or CDN URL)
IMG_URL="https://<your-cdn-or-s3-url>/weather.png"

# Telemetry API endpoint and key (API Gateway URL for the KindleBattery Lambda)
TELE_URL="https://<api-id>.execute-api.<region>.amazonaws.com/prod/KindleBattery"
TELE_API_KEY="'x-api-key: <your-api-key>'"
